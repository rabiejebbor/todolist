{
  "name": "Tool: Read GitHub File Implementation",
  "nodes": [
    {
      "parameters": {},
      "id": "webhook-read-file",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "read-github-file"
    },
    {
      "parameters": {
        "jsCode": "// Get context from parent workflow\nconst filePath = $json.file_path;\nconst context = $executionData.context || {};\nconst repoOwner = context.repo_owner || $json.repo_owner;\nconst repoName = context.repo_name || $json.repo_name;\n\nreturn {\n  json: {\n    file_path: filePath,\n    repo_owner: repoOwner,\n    repo_name: repoName\n  }\n};"
      },
      "id": "parse-input-read",
      "name": "Parse Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "url": "=https://api.github.com/repos/{{ $json.repo_owner }}/{{ $json.repo_name }}/contents/{{ $json.file_path }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "get-file-content",
      "name": "Get File from GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\n\n// Check if file exists\nif (response.message === 'Not Found') {\n  return {\n    json: {\n      content: '',\n      path: $('Parse Input').first().json.file_path,\n      error: 'File not found'\n    }\n  };\n}\n\n// Decode base64 content\nconst content = Buffer.from(response.content, 'base64').toString('utf-8');\n\nreturn {\n  json: {\n    content: content,\n    path: response.path,\n    size: response.size,\n    sha: response.sha\n  }\n};"
      },
      "id": "decode-content",
      "name": "Decode Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "return-result-read",
      "name": "Return Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
